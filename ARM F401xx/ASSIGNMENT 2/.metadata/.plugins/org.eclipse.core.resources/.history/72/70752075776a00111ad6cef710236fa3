#include <stdint.h>
#include <stdio.h>
#include "stm32f401re_usart_driver.h"
#include "dht11_driver.h"
#include "stm32f401re_i2c_driver.h"
#include "ssd1306.h"

int main(void)
{
    // 1. Initialize USART
    usart2_GPIO_PinSetUp();
    USART_Handle_t usart2 = {0};
    usart2.pUSARTx = USART2;
    usart2.USART_Config.USART_Baud = USART_STD_BAUD_9600;
    USART_Init(&usart2);
    USART_PeripheralControl(USART2, ENABLE);
    USART_Transmit_String(USART2, "System Booting...\r\n");

    // 2. Initialize I2C for F401RE
    I2C_Handle_t I2C1Handle = {0};
    I2C1Handle.pI2Cx = I2C1;
    I2C1Handle.I2C_Config.I2C_SCLSpeed = I2C_SCL_SPEED_SM;
    I2C1Handle.I2C_Config.I2C_AckControl = I2C_ACK_ENABLE;

    // Configure I2C Pins (PB8=SCL, PB9=SDA)
    // Ensure you call your GPIO_Init here for PB8 and PB9
    I2C_Init(&I2C1Handle);

    USART_Transmit_String(USART2, "Initializing Display...\r\n");
    SSD1306_Init(I2C1);
    USART_Transmit_String(USART2, "Display Ready.\r\n");

    // 3. Sensors
    DHT11_Init();
    DHT11_Data_t sensorData = {0};

    while(1)
    {
        // Simple delay loop
        for(uint32_t i = 0; i < 2000000; i++);

        if(DHT11_Read(&sensorData) == DHT11_OK)
        {
            char msg[64];
            sprintf(msg, "Temp: %d.%d C\r\n", sensorData.temp_int, sensorData.temp_dec);

            // Print to Serial
            USART_Transmit_String(USART2, msg);

            // Optional: Send raw bytes to OLED to verify bus activity
            // I2C_MasterSendData(&I2C1Handle, (uint8_t*)msg, 10, SSD1306_I2C_ADDR);
        }
        else
        {
            USART_Transmit_String(USART2, "Sensor Error!\r\n");
        }
    }
}
