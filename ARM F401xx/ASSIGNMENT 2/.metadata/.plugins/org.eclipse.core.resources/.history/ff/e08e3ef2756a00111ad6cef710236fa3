#include <stdint.h>
#include <stdio.h>
#include "stm32f401re_usart_driver.h"
#include "dht11_driver.h"
#include "stm32f401re_i2c_driver.h"

// Threshold and Handles
#define TEMP_THRESHOLD 34
I2C_Handle_t i2c1_handle = {0};

int main(void)
{
    char string[60];

    // 1. Initialize USART2 for serial debugging
    usart2_GPIO_PinSetUp();
    USART_Handle_t usart2 = {0};
    usart2.pUSARTx = USART2;
    usart2.USART_Config.USART_Baud = USART_STD_BAUD_9600;
    usart2.USART_Config.USART_Mode = USART_MODE_RXTX;
    USART_Init(&usart2);
    USART_PeripheralControl(USART2, ENABLE);

    // 2. Initialize I2C1 for OLED (PB8: SCL, PB9: SDA)
    // Configure pins as AF4 (I2C1)
    GPIO_handle_t i2c_pins;
    i2c_pins.pGPIOx = GPIOB;
    i2c_pins.GPIO_PinConfig.GPIO_PinMode = GPIO_MODE_ALTFN;
    i2c_pins.GPIO_PinConfig.GPIO_PinAltFunction = AF4;
    i2c_pins.GPIO_PinConfig.GPIO_PinOPType = GPIO_OPENDRAIN;
    i2c_pins.GPIO_PinConfig.GPIO_PinPuPdControl = GPIO_PULLUP;

    i2c_pins.GPIO_PinConfig.GPIO_PinNumber = GPIO_PIN_NO_8;
    GPIO_Init(&i2c_pins);
    i2c_pins.GPIO_PinConfig.GPIO_PinNumber = GPIO_PIN_NO_9;
    GPIO_Init(&i2c_pins);

    i2c1_handle.pI2Cx = I2C1;
    i2c1_handle.I2C_Config.I2C_SCLSpeed = I2C_SCL_SPEED_SM;
    I2C_Init(&i2c1_handle);

    // 3. Initialize Sensors and Peripherals
    DHT11_Init();
    DHT11_Data_t mySensorData = {0};

    GPIO_handle_t led_green = {0};
    led_green.pGPIOx = GPIOA;
    led_green.GPIO_PinConfig.GPIO_PinNumber = GPIO_PIN_NO_5;
    led_green.GPIO_PinConfig.GPIO_PinMode = GPIO_MODE_OUT;
    GPIO_Init(&led_green);

    // SSD1306_Init(&i2c1_handle); // Initialize your display here

    while(1)
    {
        // Sample every 2 seconds
        for(uint32_t i = 0; i < 2000000; i++);

        DHT11_Read(&mySensorData);

        // LED Logic
        if(mySensorData.temp_int >= TEMP_THRESHOLD)
            GPIO_WriteToOutputPin(GPIOA, 5, GPIO_PIN_SET);
        else
            GPIO_WriteToOutputPin(GPIOA, 5, GPIO_PIN_RESET);

        // Send to Serial
        sprintf(string, "Temp: %d.%d C \r\n", mySensorData.temp_int, mySensorData.temp_dec);
        USART_Transmit_String(USART2, string);

        // Send to OLED (Using your display library)
        // SSD1306_Clear();
        // SSD1306_GotoXY(0,0);
        // SSD1306_Puts(string, &Font_7x10, 1);
        // SSD1306_UpdateScreen();
    }
}
