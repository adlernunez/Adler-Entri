#include <stdint.h>
#include <stdio.h>
#include "stm32f401xx.h"
#include "STM32F401XX_gpio_driver.h"
#include "stm32f401re_usart_driver.h"
#include "Delay.h"

int main(void)
{
    // 1. Initialize USART2 (PA2 TX, PA3 RX)
    usart2_GPIO_PinSetUp();

    USART_Handle_t usart2 = {0}; // Clear garbage memory
    usart2.pUSARTx = USART2;
    usart2.USART_Config.USART_Baud = USART_STD_BAUD_9600;
    usart2.USART_Config.USART_Mode = USART_MODE_RXTX;
    usart2.USART_Config.USART_Parity = USART_NO_PARITY;
    usart2.USART_Config.USART_StopBit = USART_STOP_BIT_1;
    usart2.USART_Config.USART_WordLength = USART_WORDLEN_8BITS;
    usart2.USART_Config.USART_OverSampling = USART_OVERSAMPLING_16;
    usart2.USART_Config.USART_HWflowControl = USART_NO_CTS_RTS;
    USART_Init(&usart2);
    USART_PeripheralControl(USART2, ENABLE);

    // 2. Setup SysTick inline for 1 microsecond ticks (16MHz clock)
    SYSTICK->LOAD = 15;
    SYSTICK->VAL = 0;
    SYSTICK->CTRL |= (1<<0) | (1<<2); // Set ENABLE and CLKSOURCE bits

    // 3. Base GPIO setup for DHT11 on PA1
    GPIO_PeriClockControl(GPIOA, ENABLE);
    GPIO_handle_t dht_pin = {0};
    dht_pin.pGPIOx = GPIOA;
    dht_pin.GPIO_PinConfig.GPIO_PinNumber = GPIO_PIN_NO_1;
    dht_pin.GPIO_PinConfig.GPIO_PinOPType = GPIO_PUSHPULL;
    dht_pin.GPIO_PinConfig.GPIO_PinSpeed = GPIO_SPEED_FAST;
    dht_pin.GPIO_PinConfig.GPIO_PinPuPdControl = GPIO_PULLUP; // Required for 1-wire bus

    char string[60];
    uint8_t data[5];

    USART_Transmit_String(USART2, "DHT11 Initialized. Reading...\r\n");

    while(1)
    {
        // DHT11 requires at least 1.5 to 2 seconds between reads
        delay_ms(2000);

        // Zero out data array
        for(int i = 0; i < 5; i++) {
            data[i] = 0;
        }

        // --- START SIGNAL ---
        // Set PA1 to Output
        dht_pin.GPIO_PinConfig.GPIO_PinMode = GPIO_MODE_OUT;
        GPIO_Init(&dht_pin);

        // Pull LOW for 18ms to wake up sensor
        GPIO_WriteToOutputPin(GPIOA, 1, GPIO_PIN_RESET);
        delay_ms(18);

        // Set HIGH and immediately switch to Input mode to listen
        GPIO_WriteToOutputPin(GPIOA, 1, GPIO_PIN_SET);
        dht_pin.GPIO_PinConfig.GPIO_PinMode = GPIO_MODE_IN;
        GPIO_Init(&dht_pin);

        // --- WAIT FOR SENSOR RESPONSE ---
        uint16_t timeout = 0;
        uint8_t error = 0;

        // Wait for DHT11 to pull LOW (80us response)
        timeout = 0;
        while(GPIO_READFromInputPin(GPIOA, 1) == 1) {
            timeout++;
            if(timeout > 2000) { error = 1; break; }
        }

        // Wait for DHT11 to pull HIGH (80us response)
        timeout = 0;
        while(GPIO_READFromInputPin(GPIOA, 1) == 0) {
            timeout++;
            if(timeout > 2000) { error = 1; break; }
        }

        // Wait for DHT11 to pull LOW again (Ready to transmit data)
        timeout = 0;
        while(GPIO_READFromInputPin(GPIOA, 1) == 1) {
            timeout++;
            if(timeout > 2000) { error = 1; break; }
        }

        // --- READ 40 BITS (5 BYTES) ---
        if(error == 0) {
            for(int i = 0; i < 5; i++) {
                for(int j = 0; j < 8; j++) {

                    // Wait for pin to go HIGH (Start of a bit)
                    timeout = 0;
                    while(GPIO_READFromInputPin(GPIOA, 1) == 0) {
                        timeout++;
                        if(timeout > 2000) break;
                    }

                    // Measure exactly how long the pin stays HIGH
                    uint32_t time_high = 0;
                    while(GPIO_READFromInputPin(GPIOA, 1) == 1) {
                        time_high++;
                        // 1 microsecond delay loop checking the COUNTFLAG
                        while(!(SYSTICK->CTRL & (1<<16)));
                    }

                    // Shift data left and write bit
                    data[i] <<= 1;
                    if(time_high > 40) {
                        // If HIGH duration is > 40us, it's a binary '1'
                        data[i] |= 1;
                    }
                }
            }

            // --- CHECKSUM VERIFICATION ---
            uint8_t checksum = data[0] + data[1] + data[2] + data[3];
            if(checksum == data[4]) {
                sprintf(string, "Temp: %d.%d C  |  Humidity: %d.%d %%\r\n", data[2], data[3], data[0], data[1]);
            } else {
                sprintf(string, "DHT11 Checksum Error.\r\n");
            }
        } else {
            sprintf(string, "DHT11 Timeout/Not Detected.\r\n");
        }

        // Send to serial monitor
        USART_Transmit_String(USART2, string);
    }
}
