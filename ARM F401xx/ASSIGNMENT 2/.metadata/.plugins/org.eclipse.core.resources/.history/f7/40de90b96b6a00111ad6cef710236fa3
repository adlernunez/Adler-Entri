#include "stm32f446xx_i2c_driver.h"
#include <stdio.h>

void I2C_ScanBus(I2C_Handle_t *pI2CHandle)
{
    printf("Scanning I2C bus...\n");

    for(uint8_t addr = 0; addr < 128; addr++)
    {
        // 1. Generate START
        pI2CHandle->pI2Cx->CR1 |= (1 << 8);
        while(!(pI2CHandle->pI2Cx->SR1 & (1 << 0))); // Wait SB

        // 2. Send Address + Write (0)
        pI2CHandle->pI2Cx->DR = (addr << 1);

        // 3. Wait for ADDR flag or AF flag
        uint32_t timeout = 5000;
        while(!(pI2CHandle->pI2Cx->SR1 & (1 << 1)) && !(pI2CHandle->pI2Cx->SR1 & (1 << 10)) && timeout--);

        // 4. Check results
        if(pI2CHandle->pI2Cx->SR1 & (1 << 1)) {
            printf("Device found at address: 0x%X\n", addr);
            // Clear ADDR flag
            uint32_t dummy = pI2CHandle->pI2Cx->SR1;
            dummy = pI2CHandle->pI2Cx->SR2;
            (void)dummy;
        } else if(pI2CHandle->pI2Cx->SR1 & (1 << 10)) {
            // AF (Acknowledge Failure) - nothing here
            pI2CHandle->pI2Cx->SR1 &= ~(1 << 10); // Clear AF flag
        }

        // 5. Generate STOP
        pI2CHandle->pI2Cx->CR1 |= (1 << 9);

        // Brief delay before next scan
        for(volatile int i = 0; i < 5000; i++);
    }
}
