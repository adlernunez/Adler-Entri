#include <stdint.h>
#include <stdio.h>
#include "stm32f401xx.h" // Ensure this is included for base addresses
#include "stm32f401re_usart_driver.h"
#include "dht11_driver.h"
#include "stm32f401re_i2c_driver.h"

// Define Handles globally so they persist
USART_Handle_t usart2 = {0};
I2C_Handle_t i2c1_handle = {0};

void System_Clock_Setup(void) {
    // If you are relying on the default HSI (16MHz), this is fine.
    // If your board uses HSE or PLL, you MUST configure it here.
    // For now, we assume default 16MHz HSI.
}

void GPIO_Manual_Init(void) {
    // 1. Manually enable clocks to be absolutely sure
    GPIOA_CLK_EN();
    GPIOB_CLK_EN();

    // 2. Setup USART Pins (PA2 TX, PA3 RX)
    usart2_GPIO_PinSetUp();

    // 3. Setup I2C Pins manually to guarantee AF4 and Open-Drain
    GPIO_handle_t i2c_pins = {0};
    i2c_pins.pGPIOx = GPIOB;
    i2c_pins.GPIO_PinConfig.GPIO_PinMode = GPIO_MODE_ALTFN;
    i2c_pins.GPIO_PinConfig.GPIO_PinAltFunction = AF4; // AF4 for I2C1
    i2c_pins.GPIO_PinConfig.GPIO_PinOPType = GPIO_OPENDRAIN; // CRITICAL FOR I2C
    i2c_pins.GPIO_PinConfig.GPIO_PinPuPdControl = GPIO_PULLUP;
    i2c_pins.GPIO_PinConfig.GPIO_PinSpeed = GPIO_SPEED_FAST;

    // Configure PB8 (SCL)
    i2c_pins.GPIO_PinConfig.GPIO_PinNumber = GPIO_PIN_NO_8;
    GPIO_Init(&i2c_pins);

    // Configure PB9 (SDA)
    i2c_pins.GPIO_PinConfig.GPIO_PinNumber = GPIO_PIN_NO_9;
    GPIO_Init(&i2c_pins);
}

int main(void)
{
    // 1. Clock and GPIO Setup
    System_Clock_Setup();
    GPIO_Manual_Init();

    // 2. USART Initialization
    usart2.pUSARTx = USART2;
    usart2.USART_Config.USART_Baud = USART_STD_BAUD_9600;
    usart2.USART_Config.USART_Mode = USART_MODE_TX_ONLY; // TX only for debugging
    USART_Init(&usart2);
    USART_PeripheralControl(USART2, ENABLE);

    // TEST 1: Does Serial Work?
    // If this does not print, your clock or USART configuration is fundamentally broken.
    for(uint32_t i=0; i<500000; i++); // Small delay before printing
    USART_Transmit_String(USART2, "\r\n=== SYSTEM BOOT ===\r\n");

    // 3. I2C Initialization
    USART_Transmit_String(USART2, "Init I2C...\r\n");
    i2c1_handle.pI2Cx = I2C1;
    i2c1_handle.I2C_Config.I2C_SCLSpeed = I2C_SCL_SPEED_SM;
    i2c1_handle.I2C_Config.I2C_AckControl = I2C_ACK_ENABLE;
    I2C_Init(&i2c1_handle);
    USART_Transmit_String(USART2, "I2C Peripheral Ready.\r\n");

    // TEST 2: I2C Scanner (Safe test to find OLED address)
    USART_Transmit_String(USART2, "Scanning I2C Bus...\r\n");
    uint8_t found_address = 0;

    // Scan addresses 0x01 to 0x7E
    for(uint8_t addr = 1; addr < 127; addr++) {
        // Generate Start
        I2C1->I2C_CR1 |= (1 << 8);
        uint32_t timeout = 0xFFF;
        while(!(I2C1->I2C_SR1 & (1 << 0))) { if(--timeout == 0) break; }

        if(timeout > 0) {
            // Send Address + Write Bit
            I2C1->I2C_DR = (addr << 1);
            timeout = 0xFFF;

            // Wait for ADDR (ACK) or AF (NACK)
            while(1) {
                if(I2C1->I2C_SR1 & (1 << 1)) { // ADDR Flag (Device found!)
                    found_address = addr;
                    (void)I2C1->I2C_SR1; (void)I2C1->I2C_SR2; // Clear ADDR
                    break;
                }
                if(I2C1->I2C_SR1 & (1 << 10)) { // AF Flag (No device)
                    I2C1->I2C_SR1 &= ~(1 << 10); // Clear AF
                    break;
                }
                if(--timeout == 0) break;
            }
        }
        // Generate Stop
        I2C1->I2C_CR1 |= (1 << 9);
        for(uint32_t delay=0; delay<1000; delay++); // Delay between scans
    }

    if(found_address) {
        char msg[50];
        sprintf(msg, "Found Device at: 0x%02X\r\n", found_address);
        USART_Transmit_String(USART2, msg);
    } else {
        USART_Transmit_String(USART2, "No I2C Devices Found!\r\n");
    }

    while(1) {
        // Halt here for debugging
    }
}
