#include "HCSR04_DRIVER.h"

void SysTick_Delay_init(void)
{
    SYSTICK->LOAD = 15;  // Load top as 15, frequency=16MHz/15+1=1MHz, overflow on each microseconds
    SYSTICK->VAL = 0;    // clear current value
    SYSTICK->CTRL |= (1<<SYSTICK_CTRL_ENABLE)|(1<<SYSTICK_CTRL_CLKSOURCE); // start counting, use CPU clock
}

void Delay_us(uint32_t time)
{
    for(uint32_t i=0; i<time;i++)
    {
        while(!(SYSTICK->CTRL&(1<<SYSTICK_CTRL_COUNTFLAG))); // 1us delay, reading CTRL clears Flag
    }
}

void GPIO_setup(void)
{
    // Initialize structs to 0 to prevent garbage memory issues
    GPIO_handle_t output = {0}, trigger = {0}, echo = {0};

    // 1. Setup PA0 (Output/Buzzer)
    output.pGPIOx = GPIOA;
    output.GPIO_PinConfig.GPIO_PinNumber = OUTPUT_PIN;
    output.GPIO_PinConfig.GPIO_PinMode = GPIO_MODE_OUT;
    output.GPIO_PinConfig.GPIO_PinOPType = GPIO_PUSHPULL;
    output.GPIO_PinConfig.GPIO_PinSpeed = GPIO_SPEED_FAST;
    output.GPIO_PinConfig.GPIO_PinPuPdControl = GPIO_NO_PUPD;
    GPIO_Init(&output);

    // 2. Setup PA1 (Trigger)
    trigger.pGPIOx = GPIOA;
    trigger.GPIO_PinConfig.GPIO_PinNumber = TRIGGER_PIN;
    trigger.GPIO_PinConfig.GPIO_PinMode = GPIO_MODE_OUT;
    trigger.GPIO_PinConfig.GPIO_PinOPType = GPIO_PUSHPULL;
    trigger.GPIO_PinConfig.GPIO_PinSpeed = GPIO_SPEED_FAST;
    trigger.GPIO_PinConfig.GPIO_PinPuPdControl = GPIO_NO_PUPD;
    GPIO_Init(&trigger);

    // Set trigger low by default
    GPIO_WriteToOutputPin(GPIOA, TRIGGER_PIN, GPIO_PIN_RESET);

    // 3. Setup PA4 (Echo)
    echo.pGPIOx = GPIOA;
    echo.GPIO_PinConfig.GPIO_PinNumber = ECHO_PIN;
    echo.GPIO_PinConfig.GPIO_PinMode = GPIO_MODE_IN;
    echo.GPIO_PinConfig.GPIO_PinOPType = GPIO_PUSHPULL;
    echo.GPIO_PinConfig.GPIO_PinSpeed = GPIO_SPEED_FAST;
    echo.GPIO_PinConfig.GPIO_PinPuPdControl = GPIO_PULLDOWN;
    GPIO_Init(&echo);
}

void Send_Trigger(void)
{
    Delay_us(2);
    GPIOA->ODR |= (1<<TRIGGER_PIN);          // Set Trigger Pin HIGH for 10us
    Delay_us(10);
    GPIOA->ODR &=~(1<<TRIGGER_PIN);          // Reset Trigger Pin LOW
}

void Timer2_Init(void)
{
    TIM2_CLK_EN();
    TIM2->ARR = 65565;                        // Time period as 65.5ms
    TIM2->PSC = 15;                           // Timer frequency as 16MHz/(15+1)= 1MHz
    TIM2->CR1 |= (1<<TIMx_CR1_CEN);           // Start Count
}

uint32_t HCSR04_GetDistance(void)
{
    Send_Trigger();

    while(!(GPIOA->IDR & (1<< ECHO_PIN)));    // Wait till echo pin goes HIGH

    TIM2->CNT = 0;                            // Reset Timer : start count from 0

    while((GPIOA->IDR & (1<< ECHO_PIN)));     // wait till echo pin goes LOW

    uint32_t echo_time = TIM2->CNT;           // Read count value for echo time (in us)

    return (echo_time)/58;                    // distance = echo time/58
}

void Buzzer_ON(void)
{
    GPIOA->ODR |= (1<<OUTPUT_PIN);
}

void Buzzer_OFF(void)
{
    GPIOA->ODR &=~(1<<OUTPUT_PIN);
}
