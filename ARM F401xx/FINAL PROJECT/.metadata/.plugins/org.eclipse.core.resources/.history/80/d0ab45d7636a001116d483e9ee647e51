/**
 * @file           : 3_I2c_display_temp_data.c
 * @brief          : DHT11 Temp Data to GME12864 OLED via I2C
 */

#include <stdint.h>
#include <stdio.h>
#include "stm32f446xx_gpio_driver.h"
#include "stm32f446xx_usart_driver.h"
#include "dht11_driver.h"
#include "OLED_driver.h"

// Define threshold for LED feedback
#define TEMP_THRESHOLD 34

int main(void)
{
    // 1. Initialize System Peripherals
    DHT11_Init();

    // 2. Setup I2C1 for OLED (PB8: SCL, PB9: SDA)
    I2C_Handle_t I2C1Handle = {0};
    I2C1Handle.pI2Cx = I2C1;
    I2C1Handle.I2C_Config.I2C_SCLSpeed = I2C_SCL_SPEED_SM;
    I2C1Handle.I2C_Config.I2C_DeviceAddress = OLED_ADDRESS; // 0x3C
    I2C_Init(&I2C1Handle);

    // 3. Initialize Display
    OLED_Init(&I2C1Handle);
    OLED_Clear(&I2C1Handle);

    // 4. Initialize Green LED (PA5)
    GPIO_Handle_t led_green = {0};
    led_green.pGPIOx = GPIOA;
    led_green.GPIO_PinConfig.GPIO_PinNumber = GPIO_PIN_NO_5;
    led_green.GPIO_PinConfig.GPIO_PinMode = GPIO_MODE_OUT;
    led_green.GPIO_PinConfig.GPIO_PinSpeed = GPIO_SPEED_FAST;
    led_green.GPIO_PinConfig.GPIO_PinOPType = GPIO_OP_TYPE_PP;
    led_green.GPIO_PinConfig.GPIO_PinPuPdControl = GPIO_NO_PUPD;
    GPIO_Init(&led_green);

    DHT11_Data_t sensorData = {0};
    char displayBuffer[30];

    while(1)
    {
        // A. Read sensor data
        if(DHT11_Read(&sensorData) == DHT11_OK)
        {
            // B. Format string for OLED and Serial Monitor
            sprintf(displayBuffer, "Temp: %d.%d C", sensorData.temp_int, sensorData.temp_dec);

            // C. Update LED Logic
            if(sensorData.temp_int >= TEMP_THRESHOLD) {
                GPIO_WriteToOutputPin(GPIOA, GPIO_PIN_NO_5, GPIO_PIN_SET);
            } else {
                GPIO_WriteToOutputPin(GPIOA, GPIO_PIN_NO_5, GPIO_PIN_RESET);
            }

            // D. Update OLED
            OLED_Clear(&I2C1Handle);
            OLED_DisplayString(&I2C1Handle, displayBuffer);
        }
        else
        {
            // Handle sensor error
            OLED_Clear(&I2C1Handle);
            OLED_DisplayString(&I2C1Handle, "Sensor Error");
        }

        // E. Stabilize (2s delay per DHT11 datasheet requirement)
        for(uint32_t i = 0; i < 2000000; i++);
    }

    return 0;
}
