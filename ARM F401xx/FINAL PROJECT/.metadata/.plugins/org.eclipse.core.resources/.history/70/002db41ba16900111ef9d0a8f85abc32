#include <stdint.h>
#include "STM32F401XX_gpio_driver.h"
#include "HCSR04_DRIVER.h"

int main(void)
{
    // 1. Initialize System Clocks and Timers
    SysTick_Delay_init();
    Timer2_Init();

    // 2. Initialize GPIO Pins
    // Ensure GPIOA clock is enabled before configuring the pins
    GPIO_PeriClockControl(GPIOA, ENABLE);
    GPIO_setup();

    uint32_t distance;

    // 3. Infinite Processing Loop
    while(1)
    {
        distance = HCSR04_GetDistance();

        // Check if object is closer than 10cm (and ignore 0/timeout readings)
        if(distance > 0 && distance < 10)
        {
            Buzzer_ON();
        }
        else
        {
            Buzzer_OFF();
        }

        Delay_us(500000); // 500ms delay between readings
    }

    return 0;
}
