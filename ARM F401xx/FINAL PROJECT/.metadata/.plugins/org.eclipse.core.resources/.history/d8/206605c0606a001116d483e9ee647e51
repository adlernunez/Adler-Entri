#include "dht11_driver.h"

// Reusing your provided SysTick initialization
void DHT11_Init(void) {
    SYSTICK->LOAD = 15;
    SYSTICK->VAL = 0;
    SYSTICK->CTRL |= (1<<0) | (1<<2);

    GPIO_PeriClockControl(GPIOA, ENABLE);
}

