    dht_pin.GPIO_PinConfig.GPIO_PinMode = GPIO_MODE_IN;
    GPIO_Init(&dht_pin);

    // Using your driver's API: GPIO_ReadFromInputPin
    timeout = 0;
    while(GPIO_ReadFromInputPin(GPIOA, 1) == 1) { if(++timeout > 5000) return DHT11_ERROR_TIMEOUT; }

