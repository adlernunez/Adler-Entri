    dht_pin.GPIO_PinConfig.GPIO_PinOPType = GPIO_OP_TYPE_PP;
        dht_pin.GPIO_PinConfig.GPIO_PinPuPdControl = GPIO_PIN_PU;

    // --- START SIGNAL (Output) ---
    dht_pin.GPIO_PinConfig.GPIO_PinMode = GPIO_MODE_OUT;
    GPIO_Init(&dht_pin);

    GPIO_WriteToOutputPin(GPIOA, 1, 0); // Reset
    // Using your driver's timing logic
    for(uint32_t i = 0; i < 18000; i++) { while(!(SYSTICK->CTRL & (1<<16))); }

    GPIO_WriteToOutputPin(GPIOA, 1, 1); // Set

