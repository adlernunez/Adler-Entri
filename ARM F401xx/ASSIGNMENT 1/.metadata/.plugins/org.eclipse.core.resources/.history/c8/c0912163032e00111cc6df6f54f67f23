typedef struct
{
	uint8_t GPIO_PinNumber;
	uint8_t GPIO_PinMode;			// input/output, alternate/analog
	uint8_t GPIO_PinSpeed;			//low, medium, high, vhigh
	uint8_t GPIO_PinPuPdControl;
	uint8_t GPIO_PinOPType;
	uint8_t GPIO_PinAltFunction;
}GPIO_PinConfig_t;

typedef struct
{
	GPIO_RegDef_t *pGPIOx;
	GPIO_PinConfig_t GPIO_PinConfig;

}GPIO_handle_t;

