#ifndef INC_STM32F401XX_GPIO_DRIVER_H_
#define INC_STM32F401XX_GPIO_DRIVER_H_

#include "stm32f401xx.h"

typedef struct
{
	uint8_t GPIO_PinNumber;
	uint8_t GPIO_PinMode;			// input/output, alternate/analog
	uint8_t GPIO_PinSpeed;			//low, medium, high, vhigh
	uint8_t GPIO_PinPuPdControl;
	uint8_t GPIO_PinOPType;
	uint8_t GPIO_PinAltFunction;
}GPIO_PinConfig_t;

typedef struct
{
	GPIO_RegDef_t *pGPIOx;
	GPIO_PinConfig_t GPIO_PinConfig;

}GPIO_handle_t;

#define GPIO_PIN_NO_0		0
#define GPIO_PIN_NO_1		1
#define GPIO_PIN_NO_2		2
#define GPIO_PIN_NO_3		3
#define GPIO_PIN_NO_4		4
#define GPIO_PIN_NO_5		5
#define GPIO_PIN_NO_6		6
#define GPIO_PIN_NO_7		7
#define GPIO_PIN_NO_8		8
#define GPIO_PIN_NO_9		9
#define GPIO_PIN_NO_10		10
#define GPIO_PIN_NO_11		11
#define GPIO_PIN_NO_12		12
#define GPIO_PIN_NO_13		13
#define GPIO_PIN_NO_14		14
#define GPIO_PIN_NO_15		15


// GPIO MODES
#define GPIO_MODE_IN 		0	//INPUT MODE	00
#define GPIO_MODE_OUT 		1	//OUTPUT MODE 	01
#define GPIO_MODE_ALTFN		2	//ALT FN MODE 	10
#define GPIO_MODE_ANALOG 	3	//ANALOG MODE 	11
#define GPIO_MODE_IT_FT		4	//INTERRUPT MODE FALLING EDGE
#define GPIO_MODE_IT_RT		5	//INTERRUPT MODE RISING EDGE
#define GPIO_MODE_IT_RFT	6	//INTERRUPT MODE RISING & FALLING EDGE

// GPIO SPEED
#define GPIO_SPEED_LOW 		0	//LOW	  	00
#define GPIO_SPEED_MEDIUM 	1	//MEDIUM 	01
#define GPIO_SPEED_FAST		2	//FAST 		10
#define GPIO_SPEED_HIGH 	3	//HIGH 		11

// GPIO PU/PD
#define GPIO_NO_PUPD 		0	// No pull-up, pull-down 	00
#define GPIO_PULLUP 		1	// Pull-up 					01
#define GPIO_PULLDOWN		2	//Pull-down 				10
#define GPIO_RESERVED 		3	//Reserved 					11

// GPIO Alternate Function (AFRL/AFRHy[3:0]) - Binary (4 bits per pin)
#define GPIO_AF0   0  // 0000: Alternate Function 0
#define GPIO_AF1   1  // 0001: Alternate Function 1
#define GPIO_AF2   2  // 0010: Alternate Function 2
#define GPIO_AF3   3  // 0011: Alternate Function 3
#define GPIO_AF4   4  // 0100: Alternate Function 4
#define GPIO_AF5   5  // 0101: Alternate Function 5 (SPI1, etc.)
#define GPIO_AF6   6  // 0110: Alternate Function 6
#define GPIO_AF7   7  // 0111: Alternate Function 7 (USART1, etc.)
#define GPIO_AF8   8  // 1000: Alternate Function 8
#define GPIO_AF9   9  // 1001: Alternate Function 9
#define GPIO_AF10 10  // 1010: Alternate Function 10
#define GPIO_AF11 11  // 1011: Alternate Function 11
#define GPIO_AF12 12  // 1100: Alternate Function 12
#define GPIO_AF13 13  // 1101: Alternate Function 13
#define GPIO_AF14 14  // 1110: Alternate Function 14
#define GPIO_AF15 15  // 1111: Alternate Function 15

// GPIO PIN OUTPUT TYPE
#define GPIO_PUSHPULL  0
#define GPIO_OPENDRAIN 1


/*
 *  GPIO PIN SET / RESET
 *
 */
#define GPIO_PIN_SET      1
#define GPIO_PIN_RESET    0



void GPIO_PeriClockControl(GPIO_RegDef_t *pGPIOx, uint8_t EnorDi);

void GPIO_Init(GPIO_handle_t *pGPIOHandle);
void GPIO_DeInit(GPIO_RegDef_t *pGPIOx); //if user wants they can use

uint8_t GPIO_READFromInputPin(GPIO_RegDef_t *pGPIOx,uint8_t PinNumber);
uint16_t GPIO_READFromInputPort(GPIO_RegDef_t *pGPIOx);

void GPIO_WriteToOututPin(GPIO_RegDef_t *pGPIOx, uint8_t PinNumber, uint8_t Value);
void GPIO_WriteToOutputPort(GPIO_RegDef_t *pGPIOx, uint16_t Value);

uint8_t GPIO_READFromOutputPin(GPIO_RegDef_t *pGPIOx,uint8_t PinNumber);
uint16_t GPIO_READFromOutputPort(GPIO_RegDef_t *pGPIOx);

void GPIO_ToggleOutputPin(GPIO_RegDef_t *pGPIOx, uint8_t PinNumber);


/*
 * IRQ Configuration and IRQ Handling
 *
 */
void GPIO_IRQInterruptControl(uint8_t IRQNumber, uint8_t EnorDi);
void GPIO_IRQPriorityConfig(uint8_t IRQNumber, uint32_t IRQPriority);
void GPIO_IRQHandling(uint8_t PinNumber);
#endif /* INC_STM32F401XX_GPIO_DRIVER_H_ */
